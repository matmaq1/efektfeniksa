<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="index, follow, max-image-preview:large">
<meta name="googlebot" content="index, follow, max-image-preview:large">
<title>Noclegi - Efekt Feniksa 2026 | Kalisz</title>
<meta name="description" content="Zarezerwuj nocleg na Efekt Feniksa 2026 w Kaliszu - miejsca w Domu Studenckim UAM Rubin od 80 zł, Hotel Seven ze śniadaniem oraz Komoda Club Residence z 15% zniżką.">
<link rel="canonical" href="https://efektfeniksa.pl/noclegi/">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;800&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#000110;--bl:#050571;--o:#FF5B00;--g:#FCA311;--w:#fff;--w6:rgba(255,255,255,.6);--w1:rgba(255,255,255,.08);--w05:rgba(255,255,255,.05)}
html{scroll-behavior:smooth}
body{font-family:'Montserrat',sans-serif;background:var(--bg);color:var(--w);overflow-x:hidden;-webkit-font-smoothing:antialiased;background-image:radial-gradient(ellipse 80% 50% at 30% 20%,rgba(5,5,113,.4) 0%,transparent 60%),radial-gradient(ellipse 70% 50% at 80% 70%,rgba(5,5,113,.35) 0%,transparent 65%);background-attachment:fixed}
img{display:block;max-width:100%}
#cv{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:0 5%;height:68px;display:flex;align-items:center;justify-content:space-between;transition:background .4s}
nav.sc{background:rgba(0,1,16,.92);backdrop-filter:blur(14px);border-bottom:1px solid rgba(252,163,17,.1)}
.logo{display:flex;align-items:center;gap:9px;text-decoration:none}
.nl{display:flex;gap:26px;list-style:none;align-items:center}
.nl a{text-decoration:none;font-weight:700;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--w6);transition:color .2s}
.nl a:hover{color:var(--g)}
.ncta{background:linear-gradient(135deg,var(--o),var(--g));color:var(--bg)!important;padding:7px 16px;border-radius:2px;font-weight:800!important}
.hbg{display:none;background:none;border:none;cursor:pointer;flex-direction:column;gap:5px;padding:4px}
.hbg span{display:block;width:22px;height:2px;background:var(--w);transition:.3s}
.hbg.open span:nth-child(1){transform:rotate(45deg) translate(5px,5px)}
.hbg.open span:nth-child(2){opacity:0}
.hbg.open span:nth-child(3){transform:rotate(-45deg) translate(5px,-5px)}

/* BUTTONS */
.bp{display:inline-flex;align-items:center;gap:7px;background:linear-gradient(135deg,var(--o),var(--g));color:var(--bg);font-family:'Montserrat',sans-serif;font-weight:800;font-size:11px;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;padding:13px 28px;border-radius:2px;border:none;cursor:pointer;transition:transform .2s,opacity .2s}
.bp:hover{transform:translateY(-2px);opacity:.9}
.bs{display:inline-flex;align-items:center;gap:7px;background:transparent;color:var(--w);font-family:'Montserrat',sans-serif;font-weight:700;font-size:11px;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;padding:12px 28px;border-radius:2px;border:1px solid rgba(255,255,255,.15);cursor:pointer;transition:border-color .2s,color .2s}
.bs:hover{border-color:var(--g);color:var(--g)}

/* FLINE */
.fl{width:100%;height:1px;background:linear-gradient(90deg,transparent,var(--o),var(--g),transparent);opacity:.2}

/* SECTIONS COMMON */
section{position:relative;z-index:2;padding:80px 5%}
.slb{font-size:10px;font-weight:700;letter-spacing:.2em;color:var(--o);text-transform:uppercase;margin-bottom:12px;display:flex;align-items:center;gap:8px}
.slb::before{content:'';display:block;width:18px;height:1px;background:var(--o)}
.st{font-size:clamp(26px,3.5vw,42px);font-weight:800;letter-spacing:-.05em;line-height:1.05;margin-bottom:12px}
.sd{font-size:14px;font-weight:400;letter-spacing:-.02em;color:var(--w6);line-height:1.7;max-width:560px}
.sh{margin-bottom:46px}
.fire{background:linear-gradient(135deg,var(--g),var(--o));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.deco{font-size:clamp(56px,11vw,140px);font-weight:800;letter-spacing:.222em;color:rgba(255,255,255,.018);text-transform:uppercase;position:absolute;pointer-events:none;user-select:none;white-space:nowrap}

/* HERO */
#nhero{padding:150px 5% 60px;position:relative;overflow:hidden}
.nhc{max-width:760px;position:relative;z-index:2}
.hlbl{font-size:10px;font-weight:700;letter-spacing:.22em;color:var(--g);text-transform:uppercase;margin-bottom:18px;display:flex;align-items:center;gap:10px}
.hlbl::before{content:'';display:block;width:24px;height:1px;background:var(--g)}
h1{font-size:clamp(32px,4.8vw,58px);font-weight:800;letter-spacing:-.05em;line-height:1.05;margin-bottom:20px}
.hsub{font-size:15px;font-weight:400;color:var(--w6);line-height:1.7;margin-bottom:32px;max-width:600px}
.hsub strong{color:var(--w);font-weight:700}
.hbtns{display:flex;gap:11px;flex-wrap:wrap}

/* KROKI */
#kroki{padding:0 5% 30px}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;max-width:1000px}
.step{background:rgba(5,5,113,.18);border:1px solid rgba(255,255,255,.06);padding:22px 20px;position:relative;overflow:hidden}
.step::after{content:'';position:absolute;bottom:0;left:0;width:100%;height:2px;background:linear-gradient(90deg,var(--o),transparent);opacity:0;transition:opacity .3s}
.step:hover::after{opacity:1}
.stepn{font-size:26px;font-weight:800;letter-spacing:-.05em;line-height:1;background:linear-gradient(135deg,var(--g),var(--o));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:9px}
.stepl{font-size:13px;font-weight:800;letter-spacing:-.02em;margin-bottom:5px}
.steps p{font-size:12px;font-weight:400;color:var(--w6);line-height:1.6}

/* KARTY OBIEKTOW */
#opcje{padding-top:50px}
.hcards{display:flex;flex-direction:column;gap:60px}
.hcard{display:grid;grid-template-columns:1fr 1.1fr;gap:0;border:1px solid rgba(255,255,255,.07);background:rgba(5,5,113,.13);overflow:hidden}
.hcard:nth-child(even) .hphotos{order:2}
.hphotos{display:flex;flex-direction:column;gap:2px;min-height:100%}
.hph1{flex:1.5;min-height:250px;position:relative;overflow:hidden}
.hph2{flex:1;min-height:150px;position:relative;overflow:hidden}
.hphotos img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.82) saturate(.9);transition:filter .5s ease,transform .6s ease}
.hcard:hover .hphotos img{filter:brightness(.95) saturate(1);transform:scale(1.03)}
.hbody{padding:36px 34px 32px;display:flex;flex-direction:column;gap:0}
.htag{display:inline-block;font-size:9px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--g);background:rgba(252,163,17,.12);padding:3px 9px;border:1px solid rgba(252,163,17,.22);border-radius:2px;width:fit-content;margin-bottom:14px}
.hname{font-size:clamp(21px,2.4vw,28px);font-weight:800;letter-spacing:-.04em;line-height:1.1;margin-bottom:10px}
.hdesc{font-size:13px;font-weight:400;color:var(--w6);line-height:1.7;margin-bottom:18px}
.hdesc strong{color:var(--w);font-weight:700}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:20px}
.chip{font-size:9px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--w6);border:1px solid rgba(255,255,255,.12);padding:4px 10px;border-radius:2px}
.prices{margin-bottom:20px}
.prow{display:flex;justify-content:space-between;align-items:baseline;gap:14px;padding:11px 0;border-top:1px solid rgba(255,255,255,.07)}
.prow:last-child{border-bottom:1px solid rgba(255,255,255,.07)}
.pname{font-size:13px;font-weight:700;letter-spacing:-.02em}
.pnote{font-size:11px;font-weight:400;color:var(--w6);margin-top:2px;line-height:1.5}
.pval{font-size:14px;font-weight:800;letter-spacing:-.02em;color:var(--g);white-space:nowrap;text-align:right}
.pval small{display:block;font-size:9px;font-weight:700;color:var(--w6);letter-spacing:.06em;text-transform:uppercase}
.haddr{display:flex;gap:10px;align-items:flex-start;margin-bottom:22px}
.haddr .ico{width:34px;height:34px;min-width:34px;background:rgba(255,91,0,.07);border:1px solid rgba(255,91,0,.15);border-radius:2px;display:flex;align-items:center;justify-content:center;font-size:14px}
.haddr a{color:var(--w);text-decoration:none;font-size:12px;font-weight:700;letter-spacing:-.01em}
.haddr a:hover{color:var(--g)}
.haddr .sub{font-size:11px;color:var(--w6);margin-top:2px;line-height:1.5}
.hcta{margin-top:auto;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.hcta .note{font-size:11px;color:var(--w6);line-height:1.5}
.hcta .note strong{color:var(--g)}

/* MAPA */
.mapgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px}
.mapcell{border:1px solid rgba(255,255,255,.07);background:rgba(5,5,113,.13);overflow:hidden}
.mapcell iframe{width:100%;height:280px;border:0;display:block;filter:grayscale(.2) invert(.86) hue-rotate(180deg) brightness(.82) contrast(1.1) saturate(.6)}
.mapcap{padding:14px 16px}
.mapcap .mcl{font-size:9px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--o);margin-bottom:3px}
.mapcap .mcn{font-size:13px;font-weight:800;letter-spacing:-.02em;margin-bottom:2px}
.mapcap .mca{font-size:11px;font-weight:400;color:var(--w6)}

/* INFO */
#info .infobox{display:grid;grid-template-columns:repeat(2,1fr);gap:2px;max-width:1000px}
.ibox{background:rgba(5,5,113,.15);border:1px solid rgba(255,255,255,.06);padding:22px 22px;display:flex;gap:13px;align-items:flex-start}
.ibox .ico{width:36px;height:36px;min-width:36px;background:rgba(255,91,0,.07);border:1px solid rgba(255,91,0,.15);border-radius:2px;display:flex;align-items:center;justify-content:center;font-size:15px}
.ibox h3{font-size:13px;font-weight:800;letter-spacing:-.02em;margin-bottom:4px}
.ibox p{font-size:12px;font-weight:400;color:var(--w6);line-height:1.65}
.ibox a{color:var(--g);text-decoration:underline}

/* CTA */
#rezerwuj{text-align:center;padding:90px 5%;position:relative;overflow:hidden}
.ctabg{position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 50% 50%,rgba(5,5,113,.55),transparent)}
.ctac{position:relative;z-index:1;max-width:660px;margin:0 auto}
.ctae{font-size:10px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--g);margin-bottom:16px}
.ctat{font-size:clamp(26px,4.2vw,50px);font-weight:800;letter-spacing:-.05em;line-height:1;margin-bottom:18px}
.ctas{font-size:14px;font-weight:400;letter-spacing:-.02em;color:var(--w6);line-height:1.6;margin-bottom:36px}
.ctabtns{display:flex;gap:11px;justify-content:center;flex-wrap:wrap}

/* FOOTER */
footer{position:relative;z-index:2;padding:40px 5% 22px;border-top:1px solid rgba(255,255,255,.05);background:rgba(0,1,16,.5)}
.ftop{display:grid;grid-template-columns:1fr auto;gap:36px;margin-bottom:32px;align-items:start}
.flinks{display:flex;gap:20px;flex-wrap:wrap;margin-top:14px}
.flinks a{text-decoration:none;font-size:10px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--w6);transition:color .2s}
.flinks a:hover{color:var(--g)}
.fsl{width:36px;height:36px;border:1px solid rgba(255,255,255,.1);border-radius:2px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;font-size:12px;font-weight:800;color:var(--w6);transition:border-color .2s,color .2s}
.fsl:hover{border-color:var(--g);color:var(--g)}
.fcopy{font-size:10px;font-weight:400;color:rgba(255,255,255,.18);letter-spacing:.04em;margin-top:18px}
.fcredit{font-size:10px;font-weight:400;color:rgba(255,255,255,.28);letter-spacing:.03em;margin-top:10px;line-height:1.6}
.flegal{display:flex;gap:18px;margin-top:8px;flex-wrap:wrap}
.flegal a{font-size:10px;color:rgba(255,255,255,.4);text-decoration:none;letter-spacing:.06em}
.flegal a:hover{color:var(--g)}

/* RESPONSIVE */
@media(max-width:960px){
  .hcard{grid-template-columns:1fr}
  .hcard:nth-child(even) .hphotos{order:0}
  .hphotos{flex-direction:row;min-height:0}
  .hph1,.hph2{flex:1;min-height:0;height:210px}
  .steps{grid-template-columns:1fr}
  .mapgrid{grid-template-columns:1fr}
  .mapcell iframe{height:240px}
  #info .infobox{grid-template-columns:1fr}
  .nl{display:none}
  .nl.open{display:flex;flex-direction:column;position:fixed;top:68px;left:0;right:0;background:rgba(0,1,16,.97);padding:20px 5%;gap:16px;border-bottom:1px solid rgba(255,255,255,.07);z-index:99}
  .hbg{display:flex}
  .ftop{grid-template-columns:1fr;gap:18px}
}
@media(max-width:680px){
  section{padding:60px 5%}
  #nhero{padding:120px 5% 40px}
  .hphotos{flex-direction:column}
  .hph1{height:220px}
  .hph2{height:150px}
  .hbody{padding:26px 20px 24px}
  .prow{flex-direction:column;gap:2px}
  .pval{text-align:left}
}
</style>
</head>
