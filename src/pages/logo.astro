---
// Ukryty ekran projektorowy: samo logo w ogniu. Do puszczenia w przerwach,
// przed startem bloku i w tle podczas wejscia publicznosci.
import Projector from '../layouts/Projector.astro';
---
<Projector title="Efekt Feniksa - ekran">
  <div class="clock" id="clock">--:--</div>

  <main class="wrap">
    <div class="mark">
      <img src="/images/logo.png" alt="Efekt Feniksa" fetchpriority="high" width="1920" height="1080">
    </div>
    <p class="tag">Rozwiń swe skrzydła w ogniu inspiracji.</p>
    <div class="meta">
      <span>Mistrzostwa Polski w Wystąpieniach Publicznych</span>
      <i></i>
      <span>28-30 sierpnia 2026</span>
      <i></i>
      <span>Kalisz</span>
    </div>
  </main>

  <div class="pj-hint" slot="hint">
    <span><kbd>F</kbd>Pełny ekran</span>
    <span><kbd>T</kbd>Timer</span>
  </div>
</Projector>

<style>
.wrap{
  flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:clamp(18px,3.2vh,44px);padding:6vh 5vw;text-align:center;
}

/* Logo: lockup ma proporcje ~2.96:1, wiec limitujemy i szerokoscia, i wysokoscia,
   zeby wypelnil kadr tak samo na 16:9 i 16:10. */
.mark{
  width:min(92vw,160vh);
  animation:in 1.4s cubic-bezier(.22,1,.36,1) both, breathe 11s ease-in-out 1.4s infinite;
  filter:drop-shadow(0 0 52px rgba(255,91,0,.45)) drop-shadow(0 0 150px rgba(252,163,17,.24));
}
/* Plik ma 1920x1080, ale sama grafika zajmuje w nim tylko srodkowy pas
   (1850x625) - reszta to przezroczysty margines. Kadrujemy do proporcji
   grafiki, zeby nie rezerwowac pustej wysokosci i zeby znak byl realnie tak
   duzy, jak pozwala na to kadr. */
.mark img{width:100%;height:auto;aspect-ratio:1850/625;object-fit:cover}

.tag{
  font-size:clamp(15px,2.05vw,40px);font-weight:700;
  color:var(--g);opacity:.95;
  text-shadow:0 0 34px rgba(252,163,17,.35);
  animation:up 1.1s cubic-bezier(.22,1,.36,1) .55s both;
}

.meta{
  display:flex;align-items:center;gap:clamp(10px,1.5vw,24px);flex-wrap:wrap;justify-content:center;
  font-size:clamp(9px,.95vw,17px);font-weight:700;letter-spacing:.2em;text-transform:uppercase;
  color:var(--w6);
  animation:up 1.1s cubic-bezier(.22,1,.36,1) .8s both;
}
/* Kropka zamiast kreski - cienkie linie rzutnik i tak gubi. */
.meta i{width:5px;height:5px;border-radius:50%;background:var(--o);flex:none}

.clock{
  position:fixed;top:3.4vh;right:3.4vw;z-index:5;
  font-size:clamp(13px,1.35vw,26px);font-weight:800;letter-spacing:.06em;
  font-variant-numeric:tabular-nums;
  color:var(--w6);
  animation:up 1.1s cubic-bezier(.22,1,.36,1) 1.05s both;
}

@keyframes in{from{opacity:0;transform:scale(.94)}to{opacity:1;transform:scale(1)}}
@keyframes up{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}
@keyframes breathe{0%,100%{transform:scale(1)}50%{transform:scale(1.016)}}

@media (prefers-reduced-motion:reduce){
  .mark,.tag,.meta,.clock{animation:none}
}
</style>

<script is:inline>
(function () {
  var el = document.getElementById('clock');
  function tick() {
    var d = new Date();
    el.textContent = String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
  }
  tick();
  setInterval(tick, 10000);

  window.addEventListener('keydown', function (e) {
    if (e.key === 't' || e.key === 'T') location.href = '/timer/';
  });
})();
</script>
