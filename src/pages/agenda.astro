---
import { agenda, ROOMS, roomSlug, groupByStart } from '../data/agenda2026';
import { speakers } from '../data/prelegenci';
import AgendaSummary from '../components/AgendaSummary.astro';

const bySlug = Object.fromEntries(speakers.map(s => [s.slug, s]));

// krotki opis pod agende: pierwszy akapit opisu wystapienia, przyciety do jednego zdania
function teaser(slug: string): string {
  const s = bySlug[slug];
  if (!s) return '';
  const first = s.desc.find(b => b.t === 'p');
  if (!first) return '';
  const txt = first.s.trim();
  if (txt.length <= 165) return txt;
  const cut = txt.slice(0, 165);
  const stop = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('? '), cut.lastIndexOf('! '));
  return stop > 70 ? cut.slice(0, stop + 1) : cut.replace(/\s+\S*$/, '') + '…';
}

const kindLabel: Record<string, string> = {
  konkurs: 'Konkurs', przerwa: 'Przerwa', wieczor: 'Wieczór',
  logistyka: 'Organizacja', scena: 'Scena główna', prelekcja: 'Prelekcja',
};

// Wiersze siatki: jeden na godzine startu, zeby trzy sale stanely obok siebie
// nawet gdy maja rozna dlugosc bloku (10:00-10:20 obok 10:00-10:45).
const daysGrouped = agenda.map(day => ({ ...day, slots: groupByStart(day.items) }));

const talkCount = agenda.flatMap(d => d.items).filter(i => i.kind === 'prelekcja').length;
---
<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="index, follow, max-image-preview:large">
<meta name="googlebot" content="index, follow, max-image-preview:large">
<title>Agenda - Efekt Feniksa 2026 | Mistrzostwa Polski Toastmasters</title>
<meta name="description" content="Szczegółowy program Efektu Feniksa 2026 - cztery konkursy mów, ponad 20 prelekcji i warsztatów na trzech salach, gala i piknik. 28-30 sierpnia 2026, Uniwersytet Kaliski.">
<link rel="canonical" href="https://efektfeniksa.pl/agenda/">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;800&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#000110;--bl:#050571;--o:#FF5B00;--g:#FCA311;--w:#fff;--w6:rgba(255,255,255,.6);--wb:rgba(255,255,255,.88);--w1:rgba(255,255,255,.08);--w05:rgba(255,255,255,.05)}
html{scroll-behavior:smooth}
body{font-family:'Montserrat',sans-serif;background:var(--bg);color:var(--w);overflow-x:hidden;-webkit-font-smoothing:antialiased;background-image:radial-gradient(ellipse 80% 50% at 30% 20%,rgba(5,5,113,.4) 0%,transparent 60%),radial-gradient(ellipse 70% 50% at 80% 70%,rgba(5,5,113,.35) 0%,transparent 65%);background-attachment:fixed}
img{display:block;max-width:100%}
#cv{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:0 5%;height:68px;display:flex;align-items:center;justify-content:space-between;transition:background .4s}
nav.sc{background:rgba(0,1,16,.92);backdrop-filter:blur(14px);border-bottom:1px solid rgba(252,163,17,.1)}
.logo{display:flex;align-items:center;gap:9px;text-decoration:none}
.nl{display:flex;gap:24px;list-style:none;align-items:center}
.nl a{text-decoration:none;font-weight:700;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--w6);transition:color .2s}
.nl a:hover,.nl a.on{color:var(--g)}
.ncta{background:linear-gradient(135deg,var(--o),var(--g));color:var(--bg)!important;padding:7px 16px;border-radius:2px;font-weight:800!important}
.hbg{display:none;background:none;border:none;cursor:pointer;flex-direction:column;gap:5px;padding:4px}
.hbg span{display:block;width:22px;height:2px;background:var(--w);transition:.3s}
.hbg.open span:nth-child(1){transform:rotate(45deg) translate(5px,5px)}
.hbg.open span:nth-child(2){opacity:0}
.hbg.open span:nth-child(3){transform:rotate(-45deg) translate(5px,-5px)}

/* BUTTONS */
.bp{display:inline-flex;align-items:center;gap:7px;background:linear-gradient(135deg,var(--o),var(--g));color:var(--bg);font-family:'Montserrat',sans-serif;font-weight:800;font-size:11px;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;padding:13px 28px;border-radius:2px;border:none;cursor:pointer;transition:transform .2s,opacity .2s}
.bp:hover{transform:translateY(-2px);opacity:.9}
.bs{display:inline-flex;align-items:center;gap:7px;background:transparent;color:var(--w);font-family:'Montserrat',sans-serif;font-weight:700;font-size:11px;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;padding:12px 28px;border-radius:2px;border:1px solid rgba(255,255,255,.15);cursor:pointer;transition:border-color .2s,color .2s}
.bs:hover{border-color:var(--g);color:var(--g)}
.fl{width:100%;height:1px;background:linear-gradient(90deg,transparent,var(--o),var(--g),transparent);opacity:.2}

/* SECTIONS */
section{position:relative;z-index:2;padding:70px 5%}
.slb{font-size:10px;font-weight:700;letter-spacing:.2em;color:var(--o);text-transform:uppercase;margin-bottom:12px;display:flex;align-items:center;gap:8px}
.slb::before{content:'';display:block;width:18px;height:1px;background:var(--o)}
.fire{background:linear-gradient(135deg,var(--g),var(--o));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.deco{font-size:clamp(56px,11vw,140px);font-weight:800;letter-spacing:.222em;color:rgba(255,255,255,.018);text-transform:uppercase;position:absolute;pointer-events:none;user-select:none;white-space:nowrap}

/* HERO */
#ahero{padding:150px 5% 46px;position:relative;overflow:hidden}
.ahc{max-width:820px;position:relative;z-index:2}
.hlbl{font-size:10px;font-weight:700;letter-spacing:.22em;color:var(--g);text-transform:uppercase;margin-bottom:18px;display:flex;align-items:center;gap:10px}
.hlbl::before{content:'';display:block;width:24px;height:1px;background:var(--g)}
h1{font-size:clamp(32px,4.8vw,58px);font-weight:800;letter-spacing:-.05em;line-height:1.05;margin-bottom:20px}
.hsub{font-size:15px;font-weight:400;color:var(--wb);line-height:1.7;margin-bottom:30px;max-width:660px}
.hsub strong{color:var(--w);font-weight:700}
.hbtns{display:flex;gap:11px;flex-wrap:wrap}

/* SKOKI DO DNI */
#skoki{padding:0 5% 10px}
.jump{display:flex;gap:2px;flex-wrap:wrap;max-width:900px}
.jump a{flex:1;min-width:190px;background:rgba(5,5,113,.18);border:1px solid rgba(255,255,255,.06);padding:18px 20px;text-decoration:none;color:inherit;transition:border-color .25s,background .25s}
.jump a:hover{border-color:rgba(252,163,17,.3);background:rgba(5,5,113,.3)}
.jump .jd{font-size:19px;font-weight:800;letter-spacing:-.04em;margin-bottom:4px}
.jump .jn{font-size:11px;font-weight:400;color:var(--w6);line-height:1.5}

/* DZIEN */
.dayhd{display:flex;align-items:baseline;gap:14px;margin-bottom:12px;flex-wrap:wrap}
.daynum{font-size:clamp(24px,3vw,36px);font-weight:800;letter-spacing:-.05em;line-height:1}
.daytag{font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--g);border:1px solid rgba(252,163,17,.25);background:rgba(252,163,17,.1);padding:4px 11px;border-radius:2px}
.dayintro{font-size:14px;color:var(--w6);line-height:1.7;max-width:640px;margin-bottom:34px}

/* SIATKA SAL: czas + trzy stale kolumny, zeby uklad byl ten sam w kazdym dniu */
.rgrid{display:grid;grid-template-columns:84px repeat(3,1fr);gap:2px;align-items:stretch}
.rhead{position:sticky;top:68px;z-index:3;background:rgba(0,1,16,.94);backdrop-filter:blur(10px);
  font-size:9px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--w6);
  padding:11px 14px;border:1px solid rgba(255,255,255,.08)}
.rhead.aula{color:var(--g);border-color:rgba(252,163,17,.25)}
.rh-time{color:var(--o)}
.rtime{display:flex;align-items:flex-start;padding:16px 8px 0 0;font-size:14px;font-weight:800;
  letter-spacing:-.02em;color:var(--g);white-space:nowrap}
.evtime{font-size:9px;font-weight:700;letter-spacing:.1em;color:var(--w6);white-space:nowrap}
.ev.empty{background:rgba(255,255,255,.012);border:1px dashed rgba(255,255,255,.055);border-left-width:1px;
  display:flex;align-items:center;justify-content:center;min-height:64px}
.emptyrm{font-size:8.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.13)}
.ev.span3{grid-column:2 / -1}

/* FILTR SAL (mobile) - pigulka z przesuwnym wskaznikiem */
.rfilter{display:none;position:sticky;top:74px;z-index:6;margin:0 0 14px}
.rfbar{display:flex;gap:2px;position:relative;padding:4px;border-radius:999px;
  background:rgba(10,10,42,.55);border:1px solid rgba(255,255,255,.12);
  backdrop-filter:blur(18px) saturate(1.5);-webkit-backdrop-filter:blur(18px) saturate(1.5);
  box-shadow:0 6px 22px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.14)}
.rfpill{position:absolute;top:4px;bottom:4px;left:0;width:0;border-radius:999px;
  background:linear-gradient(135deg,var(--o),var(--g));
  box-shadow:0 3px 12px rgba(255,91,0,.4),inset 0 1px 0 rgba(255,255,255,.3);
  transition:transform .42s cubic-bezier(.34,1.32,.5,1),width .42s cubic-bezier(.34,1.32,.5,1);
  pointer-events:none;z-index:0}
.rfb{position:relative;z-index:1;flex:1;border:none;background:none;cursor:pointer;
  font-family:'Montserrat',sans-serif;font-size:10px;font-weight:800;letter-spacing:.08em;
  text-transform:uppercase;color:var(--w6);padding:9px 4px;border-radius:999px;
  transition:color .3s;white-space:nowrap}
.rfb[aria-selected="true"]{color:var(--bg)}

.ev{background:rgba(5,5,113,.15);border:1px solid rgba(255,255,255,.07);border-left:2px solid rgba(255,255,255,.14);padding:16px 18px;display:flex;flex-direction:column;gap:7px;text-decoration:none;color:inherit;transition:border-color .25s,background .25s}
a.ev:hover{background:rgba(5,5,113,.28);border-left-color:var(--g)}
.ev.konkurs{border-left-color:var(--o);background:rgba(255,91,0,.07)}
.ev.wieczor,.ev.scena{border-left-color:var(--g)}
.ev.przerwa{background:rgba(255,255,255,.02);border-left-color:rgba(255,255,255,.1)}
.evtop{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.rm{font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--w6);border:1px solid rgba(255,255,255,.13);padding:3px 8px;border-radius:2px}
.rm.aula{color:var(--g);border-color:rgba(252,163,17,.28)}
.evkind{font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--o)}
.evwho{font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--o)}
.evtitle{font-size:15px;font-weight:800;letter-spacing:-.03em;line-height:1.3}
.ev.przerwa .evtitle{font-weight:700;color:var(--w6)}
.evnote{font-size:12.5px;font-weight:400;color:var(--wb);line-height:1.65}
.evmore{font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--w6);margin-top:auto;padding-top:4px}
a.ev:hover .evmore{color:var(--g)}

/* LEGENDA */
.legend{display:flex;gap:18px;flex-wrap:wrap;margin-top:34px;padding-top:20px;border-top:1px solid rgba(255,255,255,.07)}
.lgi{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--w6)}
.lgb{width:14px;height:14px;border-left:2px solid var(--o);background:rgba(255,91,0,.07)}
.lgb.b2{border-left-color:var(--g);background:rgba(5,5,113,.2)}
.lgb.b3{border-left-color:rgba(255,255,255,.14);background:rgba(5,5,113,.2)}

/* CTA */
#dolacz{text-align:center;padding:90px 5%;position:relative;overflow:hidden}
.ctabg{position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 50% 50%,rgba(5,5,113,.55),transparent)}
.ctac{position:relative;z-index:1;max-width:660px;margin:0 auto}
.ctae{font-size:10px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--g);margin-bottom:16px}
.ctat{font-size:clamp(26px,4.2vw,50px);font-weight:800;letter-spacing:-.05em;line-height:1;margin-bottom:18px}
.ctas{font-size:14px;font-weight:400;letter-spacing:-.02em;color:var(--w6);line-height:1.6;margin-bottom:36px}
.ctabtns{display:flex;gap:11px;justify-content:center;flex-wrap:wrap}

/* FOOTER */
footer{position:relative;z-index:2;padding:40px 5% 22px;border-top:1px solid rgba(255,255,255,.05);background:rgba(0,1,16,.5)}
.ftop{display:grid;grid-template-columns:1fr auto;gap:36px;margin-bottom:32px;align-items:start}
.flinks{display:flex;gap:20px;flex-wrap:wrap;margin-top:14px}
.flinks a{text-decoration:none;font-size:10px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--w6);transition:color .2s}
.flinks a:hover{color:var(--g)}
.fsl{width:36px;height:36px;border:1px solid rgba(255,255,255,.1);border-radius:2px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;font-size:12px;font-weight:800;color:var(--w6);transition:border-color .2s,color .2s}
.fsl:hover{border-color:var(--g);color:var(--g)}
.fcopy{font-size:10px;font-weight:400;color:rgba(255,255,255,.18);letter-spacing:.04em;margin-top:18px}
.fcredit{font-size:10px;font-weight:400;color:rgba(255,255,255,.28);letter-spacing:.03em;margin-top:10px;line-height:1.6}
.flegal{display:flex;gap:18px;margin-top:8px;flex-wrap:wrap}
.flegal a{font-size:10px;color:rgba(255,255,255,.4);text-decoration:none;letter-spacing:.06em}
.flegal a:hover{color:var(--g)}

/* RESPONSIVE */
@media(max-width:1000px){
  .rgrid{grid-template-columns:70px repeat(3,1fr)}
  .evnote{font-size:11.5px}
}
@media(max-width:860px){
  .nl{display:none}
  .nl.open{display:flex;flex-direction:column;position:fixed;top:68px;left:0;right:0;background:rgba(0,1,16,.97);padding:20px 5%;gap:16px;border-bottom:1px solid rgba(255,255,255,.07);z-index:99}
  .hbg{display:flex}
  .ftop{grid-template-columns:1fr;gap:18px}

  /* Mobile: jedna kolumna + filtr sal. Naglowki kolumn i puste kratki znikaja,
     kazda karta niesie wlasny chip z sala. */
  .rfilter{display:block}
  .rgrid{grid-template-columns:1fr;gap:2px}
  .rhead{display:none}
  .ev.empty{display:none}
  .ev.span3{grid-column:1}
  .rtime{padding:14px 0 2px;font-size:12px;letter-spacing:.1em;color:var(--o)}
  .rtime:first-of-type{padding-top:0}
  /* filtrowanie: pozycje ogolnodostepne (data-room="all") zostaja zawsze */
  .rgrid[data-filter="aula"] .ev[data-room="w1"],
  .rgrid[data-filter="aula"] .ev[data-room="w2"],
  .rgrid[data-filter="w1"]   .ev[data-room="aula"],
  .rgrid[data-filter="w1"]   .ev[data-room="w2"],
  .rgrid[data-filter="w2"]   .ev[data-room="aula"],
  .rgrid[data-filter="w2"]   .ev[data-room="w1"]{display:none}
  .rgrid .rtime.hidden{display:none}
}
@media(max-width:680px){
  section{padding:56px 5%}
  #ahero{padding:120px 5% 34px}
  .jump a{min-width:100%}
  .rfb{font-size:9px;letter-spacing:.05em;padding:9px 2px}
}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .rfpill{transition:none}
}
</style>
</head>
<body>
<canvas id="cv"></canvas>

<!-- NAV -->
<nav id="nb">
  <a href="/" class="logo"><img src="/images/logo.png" alt="Efekt Feniksa" width="45" height="45" style="height:45px;width:auto"></a>
  <ul class="nl" id="nl">
    <li><a href="/#onas">O wydarzeniu</a></li>
    <li><a href="/agenda/" class="on">Agenda</a></li>
    <li><a href="/prelegenci/">Prelegenci</a></li>
    <li><a href="/noclegi/">Noclegi</a></li>
    <li><a href="/#faq">FAQ</a></li>
    <li><a href="https://goostaura.com/c/EFEKT%20Feniksa%202026/34203-efekt-feniksa-mistrzostwa-polski-konferencja-toastmasters-2026" target="_blank" rel="noopener" class="ncta">Dołącz do nas</a></li>
  </ul>
  <button class="hbg" id="hbg" aria-label="Menu" onclick="toggleNav()">
    <span></span><span></span><span></span>
  </button>
</nav>

<!-- HERO -->
<section id="ahero">
  <span class="deco" style="bottom:-16px;right:-60px;color:rgba(5,5,113,.18)">AGENDA</span>
  <div class="ahc">
    <div class="hlbl">Program &middot; 28-30 sierpnia 2026 &middot; Uniwersytet Kaliski</div>
    <h1>Trzy dni.<br><span class="fire">Jeden płomień.</span></h1>
    <p class="hsub">Cztery konkursy mów, <strong>{talkCount} prelekcji i warsztatów</strong> na trzech salach równolegle, piknik przy ognisku i sobotnia gala. Poniżej pełny program godzina po godzinie - kliknij w wystąpienie, żeby przeczytać pełny opis i notkę o prelegencie.</p>
    <div class="hbtns">
      <a href="https://goostaura.com/c/EFEKT%20Feniksa%202026/34203-efekt-feniksa-mistrzostwa-polski-konferencja-toastmasters-2026" target="_blank" rel="noopener" class="bp">Dołącz do nas &rarr;</a>
      <a href="/prelegenci/" class="bs">Poznaj prelegentów</a>
    </div>
  </div>
</section>

<!-- PELNY PLAN W TABELI -->
<section id="tabela" style="padding-top:0;padding-bottom:26px">
  <AgendaSummary />
</section>

<!-- SKOKI -->
<section id="skoki">
  <div class="jump">
    {daysGrouped.map(d => (
      <a href={`#${d.key}`}>
        <div class="jd">{d.label} {d.date}</div>
        <div class="jn">{d.items.filter(i => i.kind === 'prelekcja').length} wystąpień &middot; {d.items.filter(i => i.kind === 'konkurs').length} punktów konkursowych</div>
      </a>
    ))}
  </div>
</section>

{daysGrouped.map(day => (
<>
<div class="fl"></div>
<section id={day.key}>
  <span class="deco" style="top:0;right:-16px">{day.label.toUpperCase()}</span>
  <div class="dayhd">
    <h2 class="daynum">{day.label} {day.date}</h2>
    <span class="daytag">{day.items.filter(i => i.kind === 'prelekcja').length} wystąpień</span>
  </div>
  <p class="dayintro">{day.intro}</p>

  <div class="rfilter">
    <div class="rfbar" role="tablist" aria-label="Filtruj po sali">
      <span class="rfpill" aria-hidden="true"></span>
      <button type="button" class="rfb" role="tab" aria-selected="true" data-f="all">Wszystko</button>
      <button type="button" class="rfb" role="tab" aria-selected="false" data-f="aula">AULA</button>
      <button type="button" class="rfb" role="tab" aria-selected="false" data-f="w1">Warsztatowa I</button>
      <button type="button" class="rfb" role="tab" aria-selected="false" data-f="w2">Warsztatowa II</button>
    </div>
  </div>

  <div class="rgrid" data-filter="all">
    <div class="rhead rh-time">Czas</div>
    {ROOMS.map(r => <div class:list={['rhead', r === 'AULA' && 'aula']}>{r}</div>)}

    {day.slots.map(slot => {
      const full = slot.items.filter(i => !i.room);
      const inRoom = (room: string) => slot.items.find(i => i.room === room);
      return (
        <>
          <div class="rtime">{slot.start}</div>
          {full.length > 0 && full.map(it => {
            const note = it.note || '';
            const sp = it.speaker ? bySlug[it.speaker] : null;
            const inner = (
              <>
                <div class="evtop">
                  <span class="rm">Całe wydarzenie</span>
                  <span class="evtime">{it.time}</span>
                  {!sp && <span class="evkind">{kindLabel[it.kind]}</span>}
                </div>
                {sp && <div class="evwho">{sp.name}</div>}
                <div class="evtitle">{sp ? (sp.title || 'Temat wkrótce') : it.title}</div>
                {(note || sp) && <div class="evnote">{note || teaser(sp!.slug)}</div>}
                {sp && <div class="evmore">Zobacz pełny opis &rarr;</div>}
              </>
            );
            return sp
              ? <a class:list={['ev', it.kind, 'span3']} data-room="all" href={`/prelegenci/#${sp.slug}`}>{inner}</a>
              : <div class:list={['ev', it.kind, 'span3']} data-room="all">{inner}</div>;
          })}
          {full.length === 0 && ROOMS.map(room => {
            const it = inRoom(room);
            if (!it) return <div class="ev empty" data-room={roomSlug(room)} aria-hidden="true"><span class="emptyrm">{room}</span></div>;
            const sp = it.speaker ? bySlug[it.speaker] : null;
            const note = it.note || (sp ? teaser(sp.slug) : '');
            const inner = (
              <>
                <div class="evtop">
                  <span class:list={['rm', room === 'AULA' && 'aula']}>{room}</span>
                  <span class="evtime">{it.time}</span>
                  {!sp && <span class="evkind">{kindLabel[it.kind]}</span>}
                </div>
                {sp && <div class="evwho">{sp.name}</div>}
                <div class="evtitle">{sp ? (sp.title || 'Temat wkrótce') : it.title}</div>
                {note && <div class="evnote">{note}</div>}
                {sp && <div class="evmore">Zobacz pełny opis &rarr;</div>}
              </>
            );
            return sp
              ? <a class:list={['ev', it.kind]} data-room={roomSlug(room)} href={`/prelegenci/#${sp.slug}`}>{inner}</a>
              : <div class:list={['ev', it.kind]} data-room={roomSlug(room)}>{inner}</div>;
          })}
        </>
      );
    })}
  </div>

  <div class="legend">
    <div class="lgi"><span class="lgb"></span> Konkurs</div>
    <div class="lgi"><span class="lgb b2"></span> Scena główna / wieczór</div>
    <div class="lgi"><span class="lgb b3"></span> Prelekcje, warsztaty i organizacja</div>
  </div>
</section>
</>
))}

