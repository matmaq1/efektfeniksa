<script is:inline>
const nb = document.getElementById('nb');
window.addEventListener('scroll',()=>nb.classList.toggle('sc',scrollY>40));
function toggleNav(){
  document.getElementById('nl').classList.toggle('open');
  document.getElementById('hbg').classList.toggle('open');
}

/* Filtr sal na mobile. Jeden wspolny stan dla wszystkich trzech dni - inaczej
   kazdy dzien trzymalby wlasny wybor i plan rozjezdzalby sie przy scrollowaniu.
   Po przefiltrowaniu chowamy te godziny, ktore nie maja juz zadnej pozycji. */
(function(){
  var bars  = [].slice.call(document.querySelectorAll('.rfilter'));
  var grids = [].slice.call(document.querySelectorAll('.rgrid'));
  if (!bars.length) return;
  var state = 'all';

  function movePill(bar){
    var pill = bar.querySelector('.rfpill');
    var btn  = bar.querySelector('.rfb[data-f="' + state + '"]');
    if (!pill || !btn || bar.offsetParent === null) return;
    pill.style.width = btn.offsetWidth + 'px';
    pill.style.transform = 'translateX(' + (btn.offsetLeft - 4) + 'px)';
  }
  function pruneTimes(grid){
    var kids = [].slice.call(grid.children);
    kids.forEach(function(n){ if (n.classList.contains('rtime')) n.classList.remove('hidden'); });
    kids.forEach(function(n, i){
      if (!n.classList.contains('rtime')) return;
      var any = false;
      for (var j = i + 1; j < kids.length; j++){
        var k = kids[j];
        if (k.classList.contains('rtime')) break;
        if (k.classList.contains('ev') && getComputedStyle(k).display !== 'none'){ any = true; break; }
      }
      if (!any) n.classList.add('hidden');
    });
  }
  function apply(){
    grids.forEach(function(g){ g.setAttribute('data-filter', state); pruneTimes(g); });
    bars.forEach(function(bar){
      [].slice.call(bar.querySelectorAll('.rfb')).forEach(function(b){
        b.setAttribute('aria-selected', String(b.dataset.f === state));
      });
      movePill(bar);
    });
  }

  bars.forEach(function(bar){
    bar.addEventListener('click', function(e){
      var b = e.target.closest('.rfb');
      if (!b) return;
      state = b.dataset.f;
      apply();
    });
  });

  addEventListener('resize', apply);
  if (document.readyState === 'complete') apply();
  else addEventListener('load', apply);
})();

const cv=document.getElementById('cv'),cx=cv.getContext('2d');
function rsz(){cv.width=innerWidth;cv.height=innerHeight;}
rsz();addEventListener('resize',rsz);
const pts=[];
function mkp(){return{x:Math.random()*innerWidth,y:innerHeight*.05+Math.random()*innerHeight*.9,vx:(Math.random()-.5)*.7,vy:-Math.random()*1.1-.15,l:0,ml:130+Math.random()*200,sz:.7+Math.random()*1.9,c:Math.random()>.5?'#FF5B00':'#FCA311'};}
for(let i=0;i<130;i++){const p=mkp();p.l=Math.random()*p.ml;pts.push(p);}
(function anim(){
  cx.clearRect(0,0,cv.width,cv.height);
  for(const p of pts){
    p.l++;if(p.l>p.ml)Object.assign(p,mkp(),{l:0});
    const a=Math.sin(p.l/p.ml*Math.PI)*.55;
    p.x+=p.vx+Math.sin(p.l*.04)*.22;p.y+=p.vy;
    cx.save();cx.globalAlpha=a;cx.fillStyle=p.c;cx.shadowBlur=5;cx.shadowColor=p.c;cx.beginPath();cx.arc(p.x,p.y,p.sz,0,Math.PI*2);cx.fill();cx.restore();
  }
  requestAnimationFrame(anim);
})();
</script>
