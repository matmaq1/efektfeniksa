---
// Ukryty ekran projektorowy: duzy timer w ogniu.
// Dwa tryby:
//   /timer/                       - odliczanie przerwy/bloku (domyslnie 15 min)
//   /timer/?m=7&label=Przemowienie - wlasny czas i podpis
//   /timer/?to=2026-08-28T09:00   - odliczanie do konkretnej daty i godziny
import Projector from '../layouts/Projector.astro';
---
<Projector title="Efekt Feniksa - timer">
  <header class="top">
    <img src="/images/logo.png" alt="Efekt Feniksa" fetchpriority="high" width="1920" height="1080">
  </header>

  <main class="stage" id="stage">
    <div class="label" id="label">Przerwa</div>
    <div class="days" id="days" hidden></div>
    <div class="time" id="time">15:00</div>
    <div class="bar" id="bar"><i id="fill"></i></div>
    <div class="state" id="state">Spacja - start</div>
  </main>

  <div class="pj-hint" slot="hint">
    <span><kbd>Spacja</kbd>Start / pauza</span>
    <span><kbd>R</kbd>Reset</span>
    <span><kbd>1-9</kbd>Minuty</span>
    <span><kbd>&uarr;&darr;</kbd>&plusmn;1 min</span>
    <span><kbd>&larr;&rarr;</kbd>&plusmn;10 s</span>
    <span><kbd>F</kbd>Pełny ekran</span>
    <span><kbd>L</kbd>Logo</span>
  </div>
</Projector>

<style>
.top{padding:clamp(18px,3.6vh,46px) 5vw 0;display:flex;justify-content:center;flex:none}
/* Znak swiadomie skromny - na tym ekranie pion nalezy do cyfr. */
.top img{width:min(22vw,360px);height:auto;opacity:.92;
  filter:drop-shadow(0 0 30px rgba(255,91,0,.30))}

.stage{
  flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:clamp(8px,1.6vh,22px);padding:0 4vw 7vh;text-align:center;min-height:0;
  /* Domyslny stan barwny; klasy stanow nadpisuja tylko te dwie zmienne. */
  --grad:linear-gradient(180deg,#fff 0%,#FFE9B8 52%,#FCA311 100%);
  --tint:255,91,0;
}
.stage.warn {--grad:linear-gradient(180deg,#FFF0CB 0%,#FCA311 52%,#FF5B00 100%);--tint:252,163,17}
.stage.final{--grad:linear-gradient(180deg,#FFDCD2 0%,#FF6B3D 52%,#FF2D20 100%);--tint:255,45,32}
.stage.over {--grad:linear-gradient(180deg,#FFB9AC 0%,#FF2D20 52%,#C40E00 100%);--tint:255,45,32}

.label{
  font-size:clamp(11px,1.35vw,26px);font-weight:800;letter-spacing:.3em;text-transform:uppercase;
  color:var(--w6);
}
.days{
  font-size:clamp(14px,2.1vw,40px);font-weight:800;letter-spacing:.06em;
  color:var(--g);font-variant-numeric:tabular-nums;
}

.time{
  cursor:pointer;
  /* Baza na wypadek braku JS - wlasciwy rozmiar wylicza fit() z faktycznej
     szerokosci napisu, zeby cyfry zawsze wypelnialy kadr do granic. */
  font-size:min(21vw,36vh);
  font-weight:800;line-height:.92;letter-spacing:-.03em;
  font-variant-numeric:tabular-nums;
  background:var(--grad);
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent;
  filter:drop-shadow(0 0 46px rgba(var(--tint),.42)) drop-shadow(0 0 120px rgba(var(--tint),.18));
  transition:filter .5s ease;
}
.stage.paused .time{opacity:.72;filter:drop-shadow(0 0 30px rgba(var(--tint),.20))}
.stage.final .time{animation:beat 1s ease-out infinite}
.stage.over  .time{animation:blink 1.15s ease-in-out infinite}

.bar{
  width:min(72vw,1240px);height:10px;border-radius:999px;
  background:rgba(255,255,255,.09);overflow:hidden;
  margin:clamp(10px,2.2vh,30px) 0 clamp(4px,1vh,14px);
}
.bar i{display:block;height:100%;width:100%;background:var(--grad);
  box-shadow:0 0 26px rgba(var(--tint),.55)}
.bar[hidden]{display:none}

.state{
  min-height:1.4em;
  font-size:clamp(10px,1.1vw,20px);font-weight:800;letter-spacing:.26em;text-transform:uppercase;
  color:var(--w3);transition:color .4s ease;
}
.stage.over .state{color:#FF6B5C}

@keyframes beat{0%{transform:scale(1)}12%{transform:scale(1.028)}100%{transform:scale(1)}}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.42}}

@media (prefers-reduced-motion:reduce){
  .stage.final .time,.stage.over .time{animation:none}
}
</style>

<script is:inline>
(function () {
  var q = new URLSearchParams(location.search);

  var stage = document.getElementById('stage');
  var labelEl = document.getElementById('label');
  var daysEl = document.getElementById('days');
  var timeEl = document.getElementById('time');
  var barEl = document.getElementById('bar');
  var fillEl = document.getElementById('fill');
  var stateEl = document.getElementById('state');

  /* --- tryb ------------------------------------------------------------ */
  var targetAt = null;
  if (q.get('to')) {
    var d = new Date(q.get('to'));
    if (!isNaN(d.getTime())) targetAt = d.getTime();
  }
  var isTarget = targetAt !== null;

  labelEl.textContent = q.get('label') || (isTarget ? 'Do startu' : 'Przerwa');

  /* --- stan odliczania ------------------------------------------------- */
  var preset = Math.max(1000, (parseFloat(q.get('m')) || 15) * 60000);
  var remaining = preset;          /* pozostalo, gdy zatrzymany */
  var endAt = 0;                   /* moment zera, gdy idzie */
  var running = false;

  if (isTarget) barEl.hidden = true;
  if (q.get('autostart') === '1') start();

  function left() {
    if (isTarget) return targetAt - Date.now();
    return running ? endAt - Date.now() : remaining;
  }
  function start() {
    if (isTarget || running) return;
    endAt = Date.now() + remaining;
    running = true;
  }
  function pause() {
    if (isTarget || !running) return;
    remaining = endAt - Date.now();
    running = false;
  }
  function toggle() { running ? pause() : start(); }
  function reset() {
    if (isTarget) return;
    running = false;
    remaining = preset;
  }
  function setPreset(ms) {
    if (isTarget) return;
    preset = ms;
    remaining = ms;
    if (running) endAt = Date.now() + ms;
  }
  function nudge(ms) {
    if (isTarget) return;
    if (running) endAt += ms;
    else remaining += ms;
    /* Wydluzenie ponad pierwotny czas ma tez wydluzyc pasek postepu. */
    preset = Math.max(preset, left());
  }

  /* --- render ---------------------------------------------------------- */
  var pad = function (n) { return String(n).padStart(2, '0'); };

  /* Cyfry maja byc tak duze, jak pozwala kadr. Mierzymy realnie wyrenderowany
     napis zamiast zgadywac metryki pisma - Montserrat i font zastepczy maja
     rozne szerokosci, a MM:SS i HH:MM:SS rozna liczbe znakow. */
  var FIT_BASE = 200;
  function fit() {
    timeEl.style.fontSize = FIT_BASE + 'px';
    var r = timeEl.getBoundingClientRect();
    if (!r.width || !r.height) return;

    /* Pion, ktory zostaje po etykiecie, pasku i podpisie - liczony, a nie
       zgadywany ulamkiem, zeby cyfry zajely dokladnie cala reszte kadru. */
    var cs = getComputedStyle(stage);
    var gap = parseFloat(cs.rowGap) || 0;
    var used = parseFloat(cs.paddingBottom) || 0;
    var shown = 0;
    for (var i = 0; i < stage.children.length; i++) {
      var el = stage.children[i];
      if (el.hidden || el.offsetParent === null) continue;
      shown++;
      if (el !== timeEl) used += el.getBoundingClientRect().height;
    }
    used += gap * Math.max(0, shown - 1);

    var scale = Math.min(
      (window.innerWidth * 0.94) / r.width,
      Math.max(60, stage.clientHeight - used) / r.height
    );
    timeEl.style.fontSize = Math.max(28, FIT_BASE * scale) + 'px';
  }
  window.addEventListener('resize', fit);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
  /* null wymusza pelny zapis w pierwszej klatce - statyczny HTML nie moze
     udawac, ze stan jest juz ustawiony. */
  var lastText = '', lastDays = '', lastCn = null;

  function tick() {
    requestAnimationFrame(tick);

    var ms = left();
    var over = ms < 0;
    var abs = Math.abs(ms);
    var totalSec = Math.floor(abs / 1000);
    var days = Math.floor(totalSec / 86400);
    var hrs = Math.floor(totalSec / 3600) % 24;
    var min = Math.floor(totalSec / 60) % 60;
    var sec = totalSec % 60;

    var big = (days > 0 || hrs > 0)
      ? pad(hrs) + ':' + pad(min) + ':' + pad(sec)
      : pad(min) + ':' + pad(sec);
    var text = (over ? '+' : '') + big;

    if (text !== lastText) {
      var refit = text.length !== lastText.length;
      timeEl.textContent = text;
      lastText = text;
      if (refit) fit();
    }
    var dayText = days > 0 ? days + (days === 1 ? ' dzień' : ' dni') : '';
    if (dayText !== lastDays) {
      daysEl.textContent = dayText;
      daysEl.hidden = !dayText;
      lastDays = dayText;
    }

    /* Stan barwny + sprzezenie z intensywnoscia ognia. */
    var heat = over ? 'over'
      : abs <= 10000 ? 'final'
      : (abs <= 60000 || (!isTarget && abs <= preset * 0.15)) ? 'warn'
      : '';
    var held = !isTarget && !running;
    var cn = ('stage ' + heat + (held ? ' paused' : '')).replace(/\s+/g, ' ').trim();
    if (cn !== lastCn) {
      lastCn = cn;
      stage.className = cn;
      stateEl.textContent = over ? 'Czas minął' : held ? 'Spacja - start' : '';
      if (window.fire) {
        /* Zatrzymany timer wycisza ogien - to jedyna informacja zwrotna,
           jaka widzi sala z ostatniego rzedu. */
        window.fire.set(
          held ? 0.6 :
          heat === 'over' ? 1.75 :
          heat === 'final' ? 1.5 :
          heat === 'warn' ? 1.2 : 1.0
        );
      }
    }

    if (!isTarget) {
      var p = over ? 0 : Math.max(0, Math.min(1, ms / preset));
      fillEl.style.width = (p * 100).toFixed(2) + '%';
    }
  }
  requestAnimationFrame(tick);

  /* --- sterowanie ------------------------------------------------------ */
  /* Klikalne sa tylko cyfry, nie cale tlo - przypadkowe klikniecie w ekran
     (np. zeby uaktywnic okno) nie moze po cichu zatrzymac odliczania w trakcie
     bloku konferencji. */
  timeEl.addEventListener('click', toggle);

  var MIN = 60000;
  window.addEventListener('keydown', function (e) {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    var k = e.key;
    if (k === ' ' || k === 'Spacebar') { e.preventDefault(); toggle(); }
    else if (k === 'r' || k === 'R') reset();
    else if (k === 'ArrowUp') { e.preventDefault(); nudge(MIN); }
    else if (k === 'ArrowDown') { e.preventDefault(); nudge(-MIN); }
    else if (k === 'ArrowRight') { e.preventDefault(); nudge(10000); }
    else if (k === 'ArrowLeft') { e.preventDefault(); nudge(-10000); }
    else if (k >= '0' && k <= '9') setPreset((k === '0' ? 10 : +k) * MIN);
    else if (k === 'l' || k === 'L') location.href = '/logo/';
  });
})();
</script>
