---
// Rozwijana tabela z calym programem - na gorze /agenda i /prelegenci.
// Przycisk "Pobierz / drukuj" otwiera systemowe okno druku; arkusz @media print
// pokazuje wtedy TYLKO te tabele, wiec "Zapisz jako PDF" daje czysty plan
// do zabrania offline (dziala tak samo na iOS, Androidzie i desktopie).
import { agenda, ROOMS, groupByStart, viewItems } from '../data/agenda2026';
import { speakers } from '../data/prelegenci';

const bySlug = Object.fromEntries(speakers.map(s => [s.slug, s]));

// open=true dla wersji tylko-do-druku (/agenda): <details> musi byc rozwiniete
// juz w HTML, bo iOS Safari nie odpala zdarzenia beforeprint.
const { open = false } = Astro.props;

// krotka etykieta do komorki tabeli
function label(it: (typeof agenda)[number]['items'][number]) {
  const sp = it.speaker ? bySlug[it.speaker] : null;
  if (sp) return { who: sp.name, what: sp.title || 'Temat wkrótce', time: it.time };
  return { who: '', what: it.title || '', time: it.time };
}

const days = agenda.map(d => ({ ...d, slots: groupByStart(viewItems(d.items, 'pelna')) }));
---

<div class="asum">
  <details class="asum-box" open={open}>
    <summary class="asum-head">
      <span class="asum-ico" aria-hidden="true">🗓️</span>
      <span class="asum-txt">
        <span class="asum-t">Cały program w jednej tabeli</span>
        <span class="asum-s">Trzy dni, trzy sale &middot; rozwiń, żeby zobaczyć lub zapisać na telefon</span>
      </span>
      <span class="asum-arrow" aria-hidden="true">+</span>
    </summary>

    <div class="asum-body">
      <div class="asum-actions">
        <button type="button" class="asum-dl" onclick="window.print()">Pobierz / drukuj plan &darr;</button>
        <span class="asum-hint">W oknie druku wybierz <strong>&bdquo;Zapisz jako PDF&rdquo;</strong> - plan zmieści się na jednej stronie i zadziała offline.</span>
      </div>

      <div class="asum-scroll">
        <table class="asum-table">
          <caption class="sr">Pełny program Efektu Feniksa 2026 z podziałem na sale</caption>
          <thead>
            <tr>
              <th scope="col" class="c-time">Czas</th>
              {ROOMS.map(r => <th scope="col">{r}</th>)}
            </tr>
          </thead>
          {days.map(day => (
            <tbody>
              <tr class="asum-day">
                <th scope="colgroup" colspan="4">{day.label} {day.date}</th>
              </tr>
              {day.slots.map(slot => (
                <tr>
                  <th scope="row" class="c-time">{slot.start}</th>
                  {slot.items.some(i => !i.room) ? (
                    <td colspan="3" class="c-all">
                      {slot.items.filter(i => !i.room).map(i => {
                        const l = label(i);
                        return (
                          <span class="c-ev">
                            {l.who && <b>{l.who} &mdash; </b>}{l.what}
                            <span class="c-when">{l.time}</span>
                          </span>
                        );
                      })}
                    </td>
                  ) : ROOMS.map(room => {
                    const hit = slot.items.find(i => i.room === room);
                    if (!hit) return <td class="c-empty"></td>;
                    const l = label(hit);
                    return (
                      <td>
                        {l.who && <span class="c-who">{l.who}</span>}
                        <span class="c-what">{l.what}</span>
                        <span class="c-when">{l.time}</span>
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>
  </details>
</div>

<style>
.sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.asum{margin:0 0 8px}
.asum-box{border:1px solid rgba(252,163,17,.22);background:rgba(5,5,113,.18);border-radius:3px;overflow:hidden}
.asum-head{list-style:none;cursor:pointer;display:flex;align-items:center;gap:14px;padding:16px 20px;transition:background .25s}
.asum-head::-webkit-details-marker{display:none}
.asum-head:hover{background:rgba(5,5,113,.34)}
.asum-ico{font-size:20px;line-height:1}
.asum-txt{display:flex;flex-direction:column;gap:3px;flex:1;min-width:0}
.asum-t{font-size:14px;font-weight:800;letter-spacing:-.03em;color:#fff}
.asum-s{font-size:11.5px;font-weight:400;color:rgba(255,255,255,.6);line-height:1.5}
.asum-arrow{font-size:20px;font-weight:800;color:#FF5B00;transition:transform .3s;flex-shrink:0}
.asum-box[open] .asum-arrow{transform:rotate(45deg)}
.asum-body{padding:0 20px 20px;border-top:1px solid rgba(255,255,255,.07)}

.asum-actions{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:16px 0}
.asum-dl{background:linear-gradient(135deg,#FF5B00,#FCA311);color:#000110;font-family:'Montserrat',sans-serif;font-weight:800;font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:11px 20px;border:none;border-radius:2px;cursor:pointer;transition:transform .2s,opacity .2s}
.asum-dl:hover{transform:translateY(-2px);opacity:.9}
.asum-hint{font-size:11.5px;color:rgba(255,255,255,.6);line-height:1.55;max-width:420px}
.asum-hint strong{color:#FCA311;font-weight:700}

.asum-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
.asum-table{border-collapse:collapse;width:100%;min-width:660px;font-size:11.5px}
.asum-table th,.asum-table td{border:1px solid rgba(255,255,255,.09);padding:8px 10px;vertical-align:top;text-align:left}
.asum-table thead th{font-size:9px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#FCA311;background:rgba(0,1,16,.5);position:sticky;top:0}
.asum-table .c-time{width:74px;white-space:nowrap;font-weight:800;color:#FCA311;font-size:11px}
.asum-day th{font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#fff;background:rgba(255,91,0,.14);padding:9px 10px}
.c-who{display:block;font-size:9.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#FF5B00;margin-bottom:2px}
.c-what{display:block;font-weight:700;color:rgba(255,255,255,.9);line-height:1.4}
.c-when{display:block;font-size:9.5px;color:rgba(255,255,255,.45);margin-top:3px}
.c-empty{background:rgba(255,255,255,.015)}
.c-all{background:rgba(255,255,255,.03)}
.c-ev{display:block;font-weight:700;color:rgba(255,255,255,.75)}
.c-ev b{color:#FF5B00;font-weight:800}

@media(max-width:680px){
  .asum-head{padding:14px 15px;gap:11px}
  .asum-body{padding:0 15px 16px}
  .asum-t{font-size:13px}
}

/* Druk / zapis do PDF: tylko tabela, na bialym, w calosci rozwinieta.
   Sekcja-rodzic (#tabela) musi zostac widoczna - ukrycie jej ukryloby tabele
   w srodku, niezaleznie od tego, co ustawimy na samym .asum. */
@media print{
  :global(body > *){display:none!important}
  :global(#tabela){display:block!important;padding:0!important}
  :global(body){background:#fff!important;color:#000!important}
  .asum{display:block!important}
  .asum-box{border:none;background:#fff}
  .asum-head,.asum-actions{display:none!important}
  .asum-body{padding:0;border:none}
  .asum-scroll{overflow:visible}
  .asum-table{min-width:0;width:100%;font-size:8pt}
  .asum-table th,.asum-table td{border:.5pt solid #999;color:#000;padding:4pt 5pt}
  .asum-table thead th{color:#000;background:#eee}
  .asum-table .c-time,.c-who,.c-ev b{color:#000}
  .asum-day th{background:#ddd;color:#000}
  .c-what,.c-ev{color:#000}
  .c-when{color:#444}
  .c-empty{background:#fafafa}
}
</style>

<script is:inline>
/* Rozwin tabele przed drukiem, zeby "Zapisz jako PDF" zadzialalo takze wtedy,
   gdy uzytkownik jej nie otworzyl (Ctrl+P / Cmd+P). */
(function () {
  var box = document.querySelector('.asum-box');
  if (!box) return;
  var wasOpen = false;
  window.addEventListener('beforeprint', function () { wasOpen = box.open; box.open = true; });
  window.addEventListener('afterprint', function () { box.open = wasOpen; });
})();
</script>
