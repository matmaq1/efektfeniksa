---
// Kalendarzowy widok calego programu - glowna tresc /agenda.
//
// Wiersze siatki wynikaja z realnych granic czasowych dnia (kazdego startu i
// kazdego konca), a nie z kolejnych "slotow". Dzieki temu poszarpana niedziela
// (10:20, 10:30, 10:40) trafia na wlasciwe miejsce na osi,
// a wolne okna zostaja po prostu wolnymi oknami - bez kratek "brak".
//
// Karta jest minimalna: godzina, nazwisko, temat i jedna linijka opisu.
// Na hover (desktop) albo na srodku ekranu (mobile, klasa .on z JS ponizej)
// rozwija sie plynnie do pelnej notki ze zdjeciem prelegenta i linkiem do
// pelnego opisu, spychajac pozycje ponizej w dol.
import { agenda, ROOMS, roomSlug, viewItems, type AgendaDay, type AgendaItem } from '../data/agenda2026';
import { speakers, type Speaker } from '../data/prelegenci';

const bySlug = Object.fromEntries(speakers.map(s => [s.slug, s]));

const kindLabel: Record<string, string> = {
  konkurs: 'Konkurs', przerwa: 'Przerwa', wieczor: 'Wieczór',
  logistyka: 'Organizacja', scena: 'Scena główna', prelekcja: 'Prelekcja',
  klub: 'Spotkanie klubu',
};

/** Przycina na granicy zdania, a gdy jej nie ma w rozsadnym miejscu - na granicy slowa. */
function cut(txt: string, max: number): string {
  const t = txt.trim();
  if (t.length <= max) return t;
  const c = t.slice(0, max);
  const stop = Math.max(c.lastIndexOf('. '), c.lastIndexOf('? '), c.lastIndexOf('! '));
  return stop > max * 0.55 ? c.slice(0, stop + 1) : c.replace(/\s+\S*$/, '') + '…';
}

/** Zajawka widoczna od razu (~150 znakow): recznie napisana parafraza z danych
    prelegenta, wlasna notka pozycji albo poczatek opisu wystapienia. */
function microText(it: AgendaItem, sp: Speaker | null): string {
  if (sp?.micro) return sp.micro;
  if (it.note) return it.note;
  const first = sp?.desc.find(b => b.t === 'p');
  return first ? cut(first.s, 150) : '';
}

/** Pelniejszy opis pod rozwiniecie: kolejne akapity, az uzbiera sie sensowny kawalek. */
function fullText(sp: Speaker | null): string {
  if (!sp) return '';
  let out = '';
  for (const b of sp.desc) {
    if (b.t !== 'p') continue;
    out = out ? out + ' ' + b.s.trim() : b.s.trim();
    if (out.length >= 240) break;
  }
  return cut(out, 460);
}

const toMin = (t: string): number => {
  const m = /^(\d{1,2}):(\d{2})/.exec(t.trim());
  return m ? Number(m[1]) * 60 + Number(m[2]) : 0;
};

/** Start i koniec pozycji w minutach. Wieczory za polnoc (20:30-02:00) lecą poza 24h. */
function span(time: string): { s: number; e: number } {
  const [a, b] = time.split('-');
  const s = toMin(a);
  let e = b ? toMin(b) : s + 30;
  if (e <= s) e += 24 * 60;
  return { s, e };
}

const fmt = (m: number): string =>
  String(Math.floor(m / 60) % 24).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0');

/** Wysokosc wiersza rosnie z czasem trwania, ale sciezona z obu stron - inaczej
    piknik do 2:00 zajalby pol ekranu, a 5-minutowa szczelina znikalaby zupelnie. */
const rowPx = (dur: number): number => Math.round(Math.max(22, Math.min(160, 18 + dur * 0.75)));

function layout(day: AgendaDay) {
  const all = viewItems(day.items, 'pelna').map(it => ({ it, ...span(it.time) }));

  // Dzien bez podzialu na sale (czwartkowe spotkanie klubu) nie ma czego
  // rozkladac na kolumny - kazda pozycja dostaje wlasny wiersz i idzie pelna
  // szerokoscia. Bez tego dwie nachodzace na siebie pozycje wyladowalyby w
  // tej samej komorce siatki, jedna na drugiej.
  if (all.length > 0 && all.every(x => !x.it.room)) {
    const solo = [...all].sort((a, b) => a.s - b.s);
    return {
      day,
      rooms: false,
      heads: [],
      cols: 'var(--rail) minmax(0,1fr)',
      rows: solo.map((x, i) => ({ line: i + 1, label: fmt(x.s), full: x.s % 60 === 0, px: rowPx(x.e - x.s) })),
      items: solo.map((x, i) => ({ it: x.it, r1: i + 1, r2: i + 2, col: '2/-1', para: false, wide: true })),
    };
  }

  // Pozycje bez sali, ktore nachodza czasowo na cokolwiek innego (rejestracja
  // przez pol dnia), nie zmieszcza sie w kolumnie zadnej sali - dostaja wlasna,
  // waska kolumne tuz przy osi godzin. Wczesniej wisialy w pasku NAD siatka i
  // przez to wypadaly z osi czasu: rejestracja 14:00-19:00 nie miala na planie
  // zadnego punktu zaczepienia.
  const para = all.filter(x => !x.it.room && all.some(o => o !== x && o.s < x.e && x.s < o.e));
  const grid = all.filter(x => !para.includes(x))
    .sort((a, b) => a.s - b.s || ROOMS.indexOf(a.it.room) - ROOMS.indexOf(b.it.room));

  /** Czy w tym samym czasie dzieje sie cos w innej sali? Tylko wtedy pozycja
      musi siedziec w waskiej kolumnie swojej sali. */
  const shared = (x: typeof grid[number]) => grid.some(o =>
    o !== x && o.it.room && o.it.room !== x.it.room && o.s < x.e && x.s < o.e);

  // Piatek nie ma ANI JEDNEJ pozycji granej rownolegle w dwoch salach, wiec
  // trzy kolumny sal robily mu tylko puste miejsce obok pojedynczych kart.
  // Taki dzien leci jedna kolumna, a sala schodzi do plakietki na karcie.
  const rooms = grid.some(x => x.it.room && shared(x));

  // Granice wierszy licza sie ze WSZYSTKICH pozycji, takze rownoleglych -
  // inaczej 14:00 w ogole nie pojawiloby sie na osi.
  const bounds = [...new Set(all.flatMap(x => [x.s, x.e]))].sort((a, b) => a - b);
  const starts = new Set(all.map(x => x.s));
  const off = para.length ? 1 : 0;
  const place = (x: typeof all[number]) => ({
    r1: bounds.indexOf(x.s) + 1,
    r2: bounds.indexOf(x.e) + 1,
  });

  /** Czy w tym czasie kolumna rownolegla jest wolna? Tylko wtedy karta moze
      wejsc az do niej - inaczej wjechalaby na rejestracje albo zwiedzanie. */
  const clear = (x: typeof all[number]) => !para.some(p => p.s < x.e && x.s < p.e);

  // Pozycja, ktora nie ma w danym czasie konkurencji w innej sali, idzie przez
  // cala szerokosc: sala schodzi do plakietki na karcie, a tytul ma wreszcie
  // miejsce, zeby byc tytulem.
  const colOf = (x: typeof grid[number]) =>
    rooms && x.it.room && shared(x)
      ? String(off + ROOMS.indexOf(x.it.room) + 2)
      : `${off && !clear(x) ? off + 2 : 2}/-1`;

  return {
    day,
    rooms,
    heads: rooms
      ? ['Czas', ...(off ? ['Równolegle'] : []), ...ROOMS]
      : (off ? ['Czas', 'Równolegle', 'Program dnia'] : []),
    cols: `var(--rail) ${off ? 'var(--para) ' : ''}${rooms ? 'repeat(3,minmax(0,1fr))' : 'minmax(0,1fr)'}`,
    rows: bounds.slice(0, -1).map((s, i) => ({
      line: i + 1,
      label: starts.has(s) ? fmt(s) : null,
      full: s % 60 === 0,
      px: rowPx(bounds[i + 1] - s),
    })),
    items: [
      ...para.map(x => ({ it: x.it, ...place(x), col: '2', para: true, wide: false })),
      ...grid.map(x => {
        const col = colOf(x);
        return { it: x.it, ...place(x), col, para: false, wide: col.endsWith('/-1') };
      }),
    ],
  };
}

const days = agenda.map(layout);
---

<div class="caltop">
  <button type="button" class="calpdf" onclick="window.print()">Pobierz plan w PDF &darr;</button>
  <p class="calhint">W oknie druku wybierz <strong>&bdquo;Zapisz jako PDF&rdquo;</strong> - cały program zmieści się
  na jednej kartce i zadziała bez zasięgu. Działa tak samo na telefonie i na komputerze.</p>
</div>

{days.map(d => (
<div class="calday" id={d.day.key}>
  <div class="dayhd">
    <h2 class="daynum">{d.day.label} {d.day.date}</h2>
    {viewItems(d.day.items, 'pelna').filter(i => i.kind === 'prelekcja').length > 0 && (
      <span class="daytag">{viewItems(d.day.items, 'pelna').filter(i => i.kind === 'prelekcja').length} wystąpień</span>
    )}
  </div>
  <p class="dayintro">{d.day.intro}</p>

  {d.rooms && (
    <div class="rfilter">
      <div class="rfbar" role="tablist" aria-label="Filtruj po sali">
        <span class="rfpill" aria-hidden="true"></span>
        <button type="button" class="rfb" role="tab" aria-selected="true" data-f="all">Wszystko</button>
        <button type="button" class="rfb" role="tab" aria-selected="false" data-f="aula">AULA</button>
        <button type="button" class="rfb" role="tab" aria-selected="false" data-f="w1">Warsztatowa I</button>
        <button type="button" class="rfb" role="tab" aria-selected="false" data-f="w2">Warsztatowa II</button>
      </div>
    </div>
  )}

  {d.heads.length > 0 && (
    <div class="calhd" style={`grid-template-columns:${d.cols}`}>
      {d.heads.map(h => (
        <div class:list={[h === 'Czas' && 'chtime', h === 'Równolegle' && 'chpara', h === 'AULA' && 'aula']}>{h}</div>
      ))}
    </div>
  )}

  <div class="cal" data-filter="all" style={`grid-template-columns:${d.cols};grid-template-rows:${d.rows.map(r => `minmax(${r.px}px,auto)`).join(' ')}`}>
    {d.rows.map(row => (
      <>
        {row.label && <div class:list={['ct', !row.full && 'half']} style={`grid-row:${row.line}`}>{row.label}</div>}
        {row.label && <div class="cl" style={`grid-row:${row.line}`} aria-hidden="true"></div>}
        {d.items.filter(x => x.r1 === row.line).map(({ it, r1, r2, col, para, wide }) => {
          const sp = it.speaker ? bySlug[it.speaker] : null;
          const micro = microText(it, sp);
          const long = fullText(sp);
          // rozwiniecie ma sens tylko wtedy, gdy dokłada cos ponad zajawke:
          // dluzszy opis, zdjecie albo link do pelnej sylwetki. Pozycje z wlasna
          // grafika (czwartkowe spotkanie klubu) powtarzaja notke pod obrazkiem -
          // zajawka zwija sie przy rozwijaniu, wiec bez tego tekst by zniknal.
          const body = long && long !== micro ? long : (it.image ? it.note ?? '' : '');
          const open = !!(sp || body || it.image);
          const mini = sp?.photo ? sp.photo.replace('/prelegenci/', '/prelegenci/mini/') : null;
          const href = sp ? `/prelegenci/#${sp.slug}` : it.link ?? null;
          const style = `grid-row:${r1}/${r2};grid-column:${col}`;
          const inner = (
            <>
              <div class="evhd">
                <span class="evtime">{it.time}</span>
                <span class:list={['rm', it.room === 'AULA' && 'aula']}>{it.room || 'Całe wydarzenie'}</span>
                {!sp && <span class="evkind">{kindLabel[it.kind]}</span>}
              </div>
              {sp && <div class="evwho">{sp.name}</div>}
              <div class="evtitle">{sp ? (sp.title || 'Temat wkrótce') : it.title}</div>
              {micro && <div class="evm"><div class="evmc"><p class="evmicro">{micro}</p></div></div>}
              {open && (
                <div class="evx">
                  <div class="evxc">
                    <div class="evxi">
                      {mini && <img class="evph" src={mini} width="128" height="160" alt={sp!.name} loading="lazy" decoding="async" />}
                      <div class="evxt">
                        {it.image && <img class="evbn" src={it.image} alt={it.title} loading="lazy" decoding="async" />}
                        {body && <p class="evnote">{body}</p>}
                        {sp && <span class="evgo">Pełny opis i sylwetka &rarr;</span>}
                        {!sp && it.link && <span class="evgo">Wydarzenie na Facebooku &rarr;</span>}
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </>
          );
          return href
            ? <a class:list={['ev', it.kind, para && 'para', wide && 'wide']} data-room={roomSlug(it.room)} data-x="1" style={style}
                 href={href} target={sp ? null : '_blank'} rel={sp ? null : 'noopener'}>{inner}</a>
            : <div class:list={['ev', it.kind, para && 'para', wide && 'wide']} data-room={roomSlug(it.room)} data-x={open ? '1' : null} style={style}>{inner}</div>;
        })}
      </>
    ))}
  </div>
</div>
))}

<div class="legend">
  <div class="lgi"><span class="lgb"></span> Konkurs</div>
  <div class="lgi"><span class="lgb b2"></span> Scena główna / wieczór</div>
  <div class="lgi"><span class="lgb b3"></span> Prelekcje, warsztaty i organizacja</div>
  <div class="lgi lgh">Najedź na pozycję (na telefonie: przewiń ją na środek ekranu), żeby zobaczyć opis</div>
</div>

<style>
/* EKSPORT PDF */
.caltop{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-bottom:34px;padding:16px 20px;
  border:1px solid rgba(252,163,17,.22);background:rgba(5,5,113,.18);border-radius:3px}
.calpdf{background:linear-gradient(135deg,var(--o),var(--g));color:var(--bg);font-family:'Montserrat',sans-serif;
  font-weight:800;font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:13px 24px;border:none;
  border-radius:2px;cursor:pointer;transition:transform .2s,opacity .2s;white-space:nowrap}
.calpdf:hover{transform:translateY(-2px);opacity:.9}
.calhint{font-size:11.5px;font-weight:400;color:var(--w6);line-height:1.55;max-width:460px}
.calhint strong{color:var(--g);font-weight:700}

/* DZIEN */
.calday{--rail:74px;--para:210px;margin-bottom:56px;scroll-margin-top:86px}
.dayhd{display:flex;align-items:baseline;gap:14px;margin-bottom:10px;flex-wrap:wrap}
.daynum{font-size:clamp(24px,3vw,36px);font-weight:800;letter-spacing:-.05em;line-height:1}
.daytag{font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--g);
  border:1px solid rgba(252,163,17,.25);background:rgba(252,163,17,.1);padding:4px 11px;border-radius:2px}
.dayintro{font-size:14px;color:var(--w6);line-height:1.7;max-width:640px;margin-bottom:22px}

/* SIATKA: os godzin + (opcjonalnie) kolumna rzeczy rownoleglych + trzy sale.
   Sama siatka kolumn idzie inline z layout(), bo zalezy od dnia. */
.calhd,.cal{display:grid;gap:2px}
.calhd{position:sticky;top:68px;z-index:5;background:rgba(0,1,16,.94);backdrop-filter:blur(10px);margin-bottom:2px}
.calhd>div{font-size:9px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--w6);
  padding:11px 14px;border:1px solid rgba(255,255,255,.08)}
.calhd>div.aula{color:var(--g);border-color:rgba(252,163,17,.25)}
.chtime{color:var(--o)}
.chpara{color:rgba(255,255,255,.42);border-style:dashed!important}
.cal{position:relative;align-items:stretch}
.cal::before{content:'';position:absolute;top:0;bottom:0;left:calc(var(--rail) - 1px);width:1px;pointer-events:none;
  background:linear-gradient(180deg,rgba(252,163,17,.3),rgba(252,163,17,.05))}
.ct{grid-column:1;align-self:start;padding:2px 13px 0 0;text-align:right;white-space:nowrap;
  font-size:13px;font-weight:800;letter-spacing:-.02em;color:var(--g)}
/* pol godziny i "niekrągłe" starty sa nizsze w hierarchii, ale nadal czytelne -
   o 15:30 zaczyna sie pierwszy konkurs, to nie jest drobny druk */
.ct.half{font-size:11.5px;font-weight:700;color:rgba(252,163,17,.62)}
.cl{grid-column:2/-1;align-self:start;height:1px;background:rgba(255,255,255,.05);pointer-events:none}

/* KARTA: minimum + panel rozwijany plynnie (grid-template-rows 0fr -> 1fr).
   Rozwiniecie musi byc ustawione wprost na elementach, a nie przez zmienna CSS -
   przy var() przegladarka nie interpoluje grid-template-rows, tylko przeskakuje. */
.ev{position:relative;min-width:0;overflow:hidden;background:rgba(5,5,113,.15);
  border:1px solid rgba(255,255,255,.07);border-left:2px solid rgba(255,255,255,.14);
  padding:12px 15px;display:flex;flex-direction:column;gap:5px;text-decoration:none;color:inherit;
  transition:background .25s,border-color .25s,border-left-color .25s}
a.ev{cursor:pointer}
.ev.konkurs{border-left-color:var(--o);background:rgba(255,91,0,.07)}
.ev.wieczor,.ev.scena{border-left-color:var(--g)}
.ev.klub{border-left-color:var(--g);background:rgba(255,91,0,.06)}
.ev.przerwa{background:rgba(255,255,255,.02);border-left-color:rgba(255,255,255,.1)}
/* kolumna rzeczy rownoleglych - kreskowana ramka mowi "to trwa obok reszty",
   a waska kolumna wymusza mniejszy krok typografii */
.ev.para{border-style:dashed;border-left-style:solid;background:rgba(255,255,255,.025);padding:11px 12px}
.ev.para .evtitle{font-size:13px}
.ev.para .evmicro{font-size:11px;-webkit-line-clamp:8}
.evhd{display:flex;gap:7px;flex-wrap:wrap;align-items:center}
.evtime{font-size:9px;font-weight:700;letter-spacing:.1em;color:var(--w6);white-space:nowrap}
.rm{display:none;font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--w6);
  border:1px solid rgba(255,255,255,.13);padding:2px 7px;border-radius:2px}
.ev.wide .rm{display:inline-block}
.rm.aula{color:var(--g);border-color:rgba(252,163,17,.28)}
.evkind{font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--o)}
.evwho{font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--o)}
.evtitle{font-size:14.5px;font-weight:800;letter-spacing:-.03em;line-height:1.3}
.ev.przerwa .evtitle{font-weight:700;color:var(--w6)}
/* Karta na calej szerokosci ma miejsce na wieksza typografie. Konkursy sa osia
   calego dnia, wiec dostaja najwiecej: grubsza krawedz, mocniejsze tlo i tytul,
   ktory widac z drugiego konca strony. */
.ev.wide{padding:14px 18px}
.ev.wide .evtitle{font-size:17px}
.ev.konkurs.wide{padding:18px 20px;border-left-width:3px;background:rgba(255,91,0,.11)}
.ev.konkurs.wide .evtitle{font-size:clamp(19px,2.1vw,25px);letter-spacing:-.045em}
.ev.konkurs.wide .evkind,.ev.konkurs.wide .evtime{font-size:10px}
.ev.konkurs.wide .rm{font-size:10px;color:var(--g);border-color:rgba(252,163,17,.35)}
/* Konkursy to jedyne pozycje bez rozwiniecia - ich notka nie ma sie gdzie
   dopowiedziec, a karta i tak ciagnie sie przez kilka godzin siatki. Zdejmujemy
   wiec obciecie do czterech linijek i puszczamy caly opis. */
.ev.konkurs.wide .evmicro{display:block;overflow:visible;font-size:13px;max-width:76ch}
/* zajawka: do trzech linijek (~150 znakow), zwija sie tak samo plynnie jak panel */
.evm{display:grid;grid-template-rows:1fr;transition:grid-template-rows .45s cubic-bezier(.22,1,.36,1)}
.evmc{overflow:hidden;min-height:0}
.evmicro{display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;opacity:1;
  font-size:12px;font-weight:400;color:var(--w6);line-height:1.5;transition:opacity .25s}

.evx{display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s cubic-bezier(.22,1,.36,1)}
.evxc{overflow:hidden;min-height:0}
.evxi{display:flex;gap:13px;margin-top:8px;padding-top:11px;border-top:1px solid rgba(255,255,255,.09);
  opacity:0;transform:translateY(-8px);transition:opacity .3s ease .06s,transform .4s cubic-bezier(.22,1,.36,1)}
.evph{width:48px;height:60px;flex-shrink:0;object-fit:cover;object-position:top;border-radius:2px;
  border:1px solid rgba(252,163,17,.22)}
.evxt{min-width:0}
/* grafika wydarzenia (zamiast portretu prelegenta) - panorama, wiec idzie
   nad tekstem, a nie jako 48px kadr obok niego. Limit szerokosci jest po to,
   zeby na karcie "Cale wydarzenie" (pelna szerokosc siatki) plakat nie urosl
   na pol ekranu. */
.evbn{width:100%;max-width:380px;height:auto;margin-bottom:10px;border-radius:2px;
  border:1px solid rgba(252,163,17,.22)}
.evnote{font-size:12px;font-weight:400;color:var(--wb);line-height:1.6}
.evgo{display:inline-block;margin-top:9px;font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;
  color:var(--g);border-bottom:1px solid rgba(252,163,17,.45);padding-bottom:2px}

/* rozwiniecie: hover na desktopie, klasa .on na mobile, focus dla klawiatury */
:is(.ev.on,.ev:focus-visible) .evx{grid-template-rows:1fr}
:is(.ev.on,.ev:focus-visible) .evm{grid-template-rows:0fr}
:is(.ev.on,.ev:focus-visible) .evmicro{opacity:0}
:is(.ev.on,.ev:focus-visible) .evxi{opacity:1;transform:none}
.ev.on,a.ev:focus-visible{background:rgba(5,5,113,.32);border-left-color:var(--g)}
@media(hover:hover){
  .ev[data-x]:hover .evx{grid-template-rows:1fr}
  .ev[data-x]:hover .evm{grid-template-rows:0fr}
  .ev[data-x]:hover .evmicro{opacity:0}
  .ev[data-x]:hover .evxi{opacity:1;transform:none}
  a.ev:hover{background:rgba(5,5,113,.32);border-left-color:var(--g)}
}

/* FILTR SAL (mobile) - pigulka z przesuwnym wskaznikiem */
.rfilter{display:none;position:sticky;top:74px;z-index:6;margin:0 0 14px}
.rfbar{display:flex;gap:2px;position:relative;padding:4px;border-radius:999px;
  background:rgba(10,10,42,.55);border:1px solid rgba(255,255,255,.12);
  backdrop-filter:blur(18px) saturate(1.5);-webkit-backdrop-filter:blur(18px) saturate(1.5);
  box-shadow:0 6px 22px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.14)}
.rfpill{position:absolute;top:4px;bottom:4px;left:0;width:0;border-radius:999px;
  background:linear-gradient(135deg,var(--o),var(--g));
  box-shadow:0 3px 12px rgba(255,91,0,.4),inset 0 1px 0 rgba(255,255,255,.3);
  transition:transform .42s cubic-bezier(.34,1.32,.5,1),width .42s cubic-bezier(.34,1.32,.5,1);
  pointer-events:none;z-index:0}
.rfb{position:relative;z-index:1;flex:1;border:none;background:none;cursor:pointer;
  font-family:'Montserrat',sans-serif;font-size:10px;font-weight:800;letter-spacing:.08em;
  text-transform:uppercase;color:var(--w6);padding:9px 4px;border-radius:999px;
  transition:color .3s;white-space:nowrap}
.rfb[aria-selected="true"]{color:var(--bg)}

/* LEGENDA */
.legend{display:flex;gap:18px;flex-wrap:wrap;align-items:center;padding-top:20px;border-top:1px solid rgba(255,255,255,.07)}
.lgi{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--w6)}
.lgb{width:14px;height:14px;border-left:2px solid var(--o);background:rgba(255,91,0,.07)}
.lgb.b2{border-left-color:var(--g);background:rgba(5,5,113,.2)}
.lgb.b3{border-left-color:rgba(255,255,255,.14);background:rgba(5,5,113,.2)}
.lgh{margin-left:auto;color:rgba(255,255,255,.32);font-size:10.5px}

@media(max-width:1000px){
  .calday{--rail:62px;--para:170px}
  .ct{font-size:12px;padding-right:10px}
  .evnote{font-size:11.5px}
  /* waskie kolumny - te same ~150 znakow potrzebuje wiecej linijek */
  .evmicro{-webkit-line-clamp:5}
}
@media(max-width:860px){
  /* Mobile: jedna kolumna, os godzin robi sie naglowkiem grupy, dochodzi filtr sal.
     Inline'owe grid-row/column z siatki desktopowej trzeba zdjac. */
  .rfilter{display:block}
  .calhd,.cl,.cal::before{display:none}
  /* !important, bo siatka kolumn przychodzi inline z layout() */
  .cal{grid-template-columns:1fr!important;grid-template-rows:none!important}
  .cal>*{grid-row:auto!important;grid-column:1!important}
  .ev.para{padding:12px 15px}
  .ev.para .evtitle{font-size:14.5px}
  .ev.para .evmicro{font-size:12px;-webkit-line-clamp:4}
  /* na telefonie kazda karta jest i tak pelnej szerokosci - konkursy zostaja
     wieksze od reszty, ale bez rozmiaru z desktopu */
  .ev.wide{padding:12px 15px}
  .ev.wide .evtitle{font-size:15px}
  .ev.konkurs.wide{padding:14px 16px}
  .ev.konkurs.wide .evtitle{font-size:18px}
  .ev.konkurs.wide .evmicro{font-size:12px;max-width:none}
  .ct{text-align:left;padding:16px 0 3px;font-size:13.5px;font-weight:800;letter-spacing:.06em;color:var(--o)}
  .ct.half{font-size:12.5px;color:rgba(255,91,0,.8)}
  .ct:first-child{padding-top:0}
  .ct.hidden{display:none}
  /* bez kolumn sal godzina "od-do" jest jedynym punktem odniesienia - musi byc czytelna */
  .evhd{gap:9px}
  .evtime{font-size:12px;font-weight:800;letter-spacing:.02em;color:var(--g)}
  .evmicro{-webkit-line-clamp:4}
  .rm{display:inline-block}
  .lgh{margin-left:0;flex-basis:100%}
  /* filtrowanie po sali; pozycje ogolnodostepne (data-room="all") zostaja zawsze */
  .cal[data-filter="aula"] .ev[data-room="w1"],
  .cal[data-filter="aula"] .ev[data-room="w2"],
  .cal[data-filter="w1"]   .ev[data-room="aula"],
  .cal[data-filter="w1"]   .ev[data-room="w2"],
  .cal[data-filter="w2"]   .ev[data-room="aula"],
  .cal[data-filter="w2"]   .ev[data-room="w1"]{display:none}
}
@media(max-width:680px){
  .caltop{padding:14px 15px;gap:12px}
  .calpdf{width:100%;justify-content:center}
  .rfb{font-size:9px;letter-spacing:.05em;padding:9px 2px}
}
@media(prefers-reduced-motion:reduce){
  .evx,.evmicro,.evxi,.rfpill{transition:none}
}
</style>

<script is:inline>
/* Filtr sal na mobile. Jeden wspolny stan dla wszystkich dni - inaczej kazdy dzien
   trzymalby wlasny wybor i plan rozjezdzalby sie przy scrollowaniu. Po przefiltrowaniu
   chowamy te godziny, przy ktorych nie zostala juz zadna pozycja. */
(function () {
  var bars = [].slice.call(document.querySelectorAll('.rfilter'));
  var grids = [].slice.call(document.querySelectorAll('.cal'));
  if (!bars.length) return;
  var state = 'all';

  function movePill(bar) {
    var pill = bar.querySelector('.rfpill');
    var btn = bar.querySelector('.rfb[data-f="' + state + '"]');
    if (!pill || !btn || bar.offsetParent === null) return;
    pill.style.width = btn.offsetWidth + 'px';
    pill.style.transform = 'translateX(' + (btn.offsetLeft - 4) + 'px)';
  }
  function pruneTimes(grid) {
    var kids = [].slice.call(grid.children);
    kids.forEach(function (n) { if (n.classList.contains('ct')) n.classList.remove('hidden'); });
    kids.forEach(function (n, i) {
      if (!n.classList.contains('ct')) return;
      var any = false;
      for (var j = i + 1; j < kids.length; j++) {
        var k = kids[j];
        if (k.classList.contains('ct')) break;
        if (k.classList.contains('ev') && getComputedStyle(k).display !== 'none') { any = true; break; }
      }
      if (!any) n.classList.add('hidden');
    });
  }
  function apply() {
    grids.forEach(function (g) { g.setAttribute('data-filter', state); pruneTimes(g); });
    bars.forEach(function (bar) {
      [].slice.call(bar.querySelectorAll('.rfb')).forEach(function (b) {
        b.setAttribute('aria-selected', String(b.dataset.f === state));
      });
      movePill(bar);
    });
  }

  bars.forEach(function (bar) {
    bar.addEventListener('click', function (e) {
      var b = e.target.closest('.rfb');
      if (!b) return;
      state = b.dataset.f;
      apply();
    });
  });

  addEventListener('resize', apply);
  if (document.readyState === 'complete') apply();
  else addEventListener('load', apply);
  // Montserrat dociaga sie pozniej i zmienia szerokosci przyciskow - bez tego
  // pigulka zostaje w miejscu policzonym dla fontu zastepczego.
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(apply);
})();

/* Rozwijanie na dotyku: bez hovera aktywna jest ta pozycja, ktora przewinela sie
   na srodek ekranu. Wybieramy ostatnia karte zaczynajaca sie nad linia srodka -
   jej gora nie rusza sie przy rozwijaniu, wiec wybor jest stabilny. Krotka blokada
   po zmianie zapobiega kaskadzie, gdy zwiniecie poprzedniej podciagnie liste w gore. */
(function () {
  var cards = [].slice.call(document.querySelectorAll('.cal .ev[data-x]'));
  if (!cards.length) return;
  var active = null, locked = false, queued = false;

  function pick() {
    queued = false;
    if (locked) return;
    if (matchMedia('(hover:hover)').matches) {
      if (active) { active.classList.remove('on'); active = null; }
      return;
    }
    var line = innerHeight * 0.42, best = null, bestTop = -Infinity;
    for (var i = 0; i < cards.length; i++) {
      var c = cards[i];
      if (c.offsetParent === null) continue;
      var top = c.getBoundingClientRect().top;
      if (top <= line && top > bestTop) { bestTop = top; best = c; }
    }
    if (best === active) return;
    if (active) active.classList.remove('on');
    active = best;
    if (active) active.classList.add('on');
    locked = true;
    setTimeout(function () { locked = false; }, 420);
  }
  function onScroll() { if (!queued) { queued = true; requestAnimationFrame(pick); } }

  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  onScroll();
})();
</script>
